mat\":\"date-time\",\"description\":\"The date on which the client paid for this pricing option.\"},\"Program\":{\"description\":\"Contains information about the service category this service falls under.\",\"$ref\":\"#/definitions/Program\"},\"Remaining\":{\"type\":\"integer\",\"format\":\"int32\",\"description\":\"The number of service sessions remaining in the pricing option that can still be used.\"},\"SiteId\":{\"type\":\"integer\",\"format\":\"int32\",\"description\":\"The ID of the subscriber site associated with this pricing option.\"},\"Action\":{\"type\":\"string\",\"description\":\"The action taken.\",\"enum\":[\"None\",\"Added\",\"Updated\",\"Failed\",\"Removed\"]},\"ClientID\":{\"type\":\"string\",\"description\":\"The Client ID assigned to this pricing option, specific to when it was purchased by the client.\"},\"Returned\":{\"type\":\"boolean\",\"description\":\"Identification for purchased service is returned or not.\"}},\"title\":\"ClientMembership\"}",
